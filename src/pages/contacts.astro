---
import Contact from '@comp/Contact.astro';
import MainLayout from '../layouts/MainLayout.astro';
import ContactMap from '@comp/ContactMap.astro';
import { init } from '@utils/i18n/get-locale.js';

const { t } = init(Astro.url);

const [{ frontmatter: { committee, others } }] = await Astro.glob('../pages/contacts/index.mdx');
---

<MainLayout pageTitle={t('contacts.contacts')}>
  <h2
    class="xl:hidden bg-secondary-400-dark text-background-light dark:bg-primary-dark dark:text-background-dark whitespace-nowrap rounded-2xl py-2 md:py-3 px-3 md:px-4 text-center text-2xl md:text-3xl font-bold my-7 mx-auto text-center w-2/4 md:w-1/4"
  >
    {t('contacts.contacts')}
  </h2>
  <div
    class="xl:my-0 xl:mx-auto xl:flex xl:justify-between w-full"
    data-pagefind-body
  >
    <div class="xl:w-3/5 w-full">
      {committee && (committee.phones.length > 0 || committee.emails.length > 0) && <h2
          class="text-primary-light dark:text-primary-dark lap:mt-8 xl:mt-10 lg:mt-11 md:text-3xl lap:text-4xl xl:text-5xl lg:text-6xl text-2xl mt-1.5"
          data-pagefind-meta="title"
        >
          {t('contacts.admissionCommitteeContacts')}
        </h2>
        <Contact
          phones={committee.phones}
          emails={committee.emails}
          telegrams={committee.telegrams}
        />}
      {others && (others.length > 0) && <h2 class="mt-4 lg:mt-14 md:text-3xl lap:text-4xl xl:text-5xl text-2xl lg:text-6xl">{t('contacts.directorship')}</h2>
        <ul class="admins ml-4 lg:ml-12">
          {others.map(({ title, phone, email, telegram }) =>
            <li>
              <Contact
                title={title}
                phones={[phone]}
                emails={[email]}
                telegrams={[telegram]}
              />
            </li>)}
        </ul>}
    </div>
    <ContactMap />
  </div>
</MainLayout>
