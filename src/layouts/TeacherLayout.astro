---
import MainLayout from './MainLayout.astro';
import CentralPanel from '@comp/Shared/CentralPanel.astro';
import BasicPageHeader from '@comp/Shared/BasicPageHeader.astro';
import { init, getLocale } from '@utils/i18n/get-locale.js';
import { Image } from 'astro:assets';
import CvButton from '@comp/CvButton.astro';
import OrcidIcon from '../icons/OrcidIcon.astro';
import GoogleScholarIcon from '../icons/GoogleScholarIcon.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import PageNotFound from '@comp/Shared/PageNotFound.astro';

const { t } = init(Astro.url);
const locale = getLocale(Astro.url);
const { frontmatter } = Astro.props;

interface DepartmentFrontmatter {
  title: string;
  mtitle?: string;
  subPath?: string;
}

const departmentModules = import.meta.glob<{
  frontmatter: DepartmentFrontmatter;
}>('/src/pages/departments/*/*.mdx', { eager: true });

let departmentTitle = frontmatter?.department || '';

if (
  typeof frontmatter?.department === 'string' &&
  frontmatter.department.includes('.mdx')
) {
  const deptSlug = frontmatter.department
    .split('/')
    .pop()
    ?.replace(/\.mdx$/, '');

  if (deptSlug) {
    const targetPath = `/departments/${locale}/${deptSlug}.mdx`;
    const matchedEntry = Object.entries(departmentModules).find(([filePath]) =>
      filePath.endsWith(targetPath)
    );

    if (matchedEntry) {
      departmentTitle =
        matchedEntry[1].frontmatter.title ||
        matchedEntry[1].frontmatter.mtitle ||
        '';
    }
  }
}

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,webp}'
);

let imagePath = frontmatter.photo || '';
if (imagePath.includes('assets/')) {
  const imageName = imagePath.split('assets/').pop();
  imagePath = `/src/assets/${imageName}`;
}

let teacherImage = null;
if (allImages[imagePath]) {
  const imageModule = await allImages[imagePath]();
  teacherImage = imageModule.default;
}

const socialLinks = frontmatter.socialLinks || {};
const researchAreas = frontmatter.researchAreas || [];
const projects = frontmatter.projects || [];
---

{
  frontmatter.isPublished ? (
    <MainLayout pageTitle={frontmatter.name}>
      <CentralPanel>
        <div class="w-full xl:max-w-[1300px] mx-auto px-2 sm:px-4">
          <div class="flex flex-col md:flex-row gap-8 items-start border-b pb-8 border-primary-light/20 dark:border-primary-dark/20">
            <div class="w-48 h-60 sm:w-56 sm:h-72 flex-shrink-0 overflow-hidden rounded-lg border border-primary-light/30 dark:border-primary-dark/30 shadow-md bg-gray-100 dark:bg-gray-800">
              {teacherImage ? (
                <Image
                  src={teacherImage}
                  alt={frontmatter.name}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">
                  {t('teachers.noPhoto')}
                </div>
              )}
            </div>
            <div class="flex-grow space-y-4">
              <div>
                <BasicPageHeader title={frontmatter.name} />
                {frontmatter.position && (
                  <p class="text-lg font-medium opacity-90 mt-1">
                    {frontmatter.position}
                  </p>
                )}
                {departmentTitle && (
                  <p class="text-sm opacity-60 mt-0.5">{departmentTitle}</p>
                )}
              </div>
              {frontmatter.email && (
                <div class="text-sm">
                  <span class="font-semibold">{t('teachers.email')} </span>
                  <a
                    href={`mailto:${frontmatter.email}`}
                    class="text-accent-700-light dark:text-secondary-300-dark hover:underline"
                  >
                    {frontmatter.email}
                  </a>
                </div>
              )}
              {(socialLinks.orcid ||
                socialLinks.googleScholar ||
                socialLinks.researchGate ||
                socialLinks.linkedIn) && (
                <div class="pt-2">
                  <span class="text-xs font-semibold uppercase tracking-wider opacity-60 block mb-2">
                    {t('teachers.scientificProfiles')}
                  </span>
                  <div class="flex flex-wrap gap-2.5 items-center">
                    {socialLinks.orcid && (
                      <a
                        href={socialLinks.orcid}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:border-[#A6CE39] hover:bg-[#A6CE39]/10 transition-all duration-200"
                      >
                        <OrcidIcon />
                        <span>{t('teachers.orcid')}</span>
                      </a>
                    )}

                    {socialLinks.googleScholar && (
                      <a
                        href={socialLinks.googleScholar}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:border-[#4285F4] hover:bg-[#4285F4]/10 transition-all duration-200"
                      >
                        <GoogleScholarIcon />
                        <span>{t('teachers.googleScholar')}</span>
                      </a>
                    )}

                    {socialLinks.researchGate && (
                      <a
                        href={socialLinks.researchGate}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:border-[#00CCBB] hover:bg-[#00CCBB]/10 transition-all duration-200"
                      >
                        <span class="font-bold text-[#00CCBB] text-sm leading-none">
                          RG
                        </span>
                        <span>{t('teachers.researchGate')}</span>
                      </a>
                    )}

                    {socialLinks.linkedIn && (
                      <a
                        href={socialLinks.linkedIn}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm hover:border-[#0A66C2] hover:bg-[#0A66C2]/10 transition-all duration-200"
                      >
                        <LinkedInIcon />
                        <span>{t('teachers.linkedIn')}</span>
                      </a>
                    )}
                  </div>
                </div>
              )}
              {frontmatter.cvFile && (
                <div class="pt-2">
                  <CvButton
                    title={t('teachers.downloadCV')}
                    href={frontmatter.cvFile}
                  />
                </div>
              )}
            </div>
          </div>
          <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
            {researchAreas.length > 0 && (
              <div class="space-y-3">
                <h2 class="text-xl font-bold border-b pb-2 border-primary-light/10 dark:border-primary-dark/10">
                  {t('teachers.researchAreas')}
                </h2>
                <ul class="list-disc list-inside space-y-1.5 text-sm sm:text-base opacity-90">
                  {researchAreas.map((area: string) => (
                    <li>{area}</li>
                  ))}
                </ul>
              </div>
            )}
            {projects.length > 0 && (
              <div class="space-y-3">
                <h2 class="text-xl font-bold border-b pb-2 border-primary-light/10 dark:border-primary-dark/10">
                  {t('teachers.projects')}
                </h2>
                <ul class="space-y-2 text-sm sm:text-base">
                  {projects.map((proj: { title: string; url: string }) => (
                    <li>
                      <a
                        href={proj.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent-700-light dark:text-secondary-300-dark hover:underline font-medium break-words"
                      >
                        {proj.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </CentralPanel>
    </MainLayout>
  ) : (
    <MainLayout pageTitle={t('pageNotFound.title')}>
      <PageNotFound />
    </MainLayout>
  )
}
