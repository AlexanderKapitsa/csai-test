---
import PostIdExtractor from '@utils/post-id-extractor.js';
import { TelegramUrlValidator } from '@utils/url-validators';
import { TelegramUrlWithPostIdRegExp } from '@utils/regular-expressions';

const { id } = Astro.props;
let postId;

try {
  const isUrlValid = TelegramUrlValidator.validate(id);

  if (!isUrlValid) {
    throw new Error('An invalid URL is provided');
  }

  postId = PostIdExtractor.extract(id, TelegramUrlWithPostIdRegExp.REG_EXP);
} catch {
  postId = null;
}
---

<script
  async
  src="https://telegram.org/js/telegram-widget.js?22"
  data-telegram-post={postId}
  data-width="100%"></script>
