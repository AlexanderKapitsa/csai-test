---
const { tags, t } = Astro.props;
---

<div>
  <h3 class="text-lg md:text-xl lap:text-2xl xl:text-3xl lg:text-4xl mb-2 xl:mb-4">
    {t('tags.tags')}
  </h3>
  <ul class="flex flex-wrap gap-3 xl:gap-4">
    {
      tags.map(({ baseUrl, title }) => (
        <li>
          <a href={`${baseUrl}`}>
            <span class="inline-flex items-center bg-secondary-300-light dark:bg-primary-dark text-primary-light dark:text-white py-1.5 px-4 lg:px-8 lg:py-3 rounded-md text-xs md:text-base lap:text-lg lg:text-xl">
              {title}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
