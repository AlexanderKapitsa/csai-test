<script>
  import isEqual from 'lodash.isequal';
  import { notifyPointsGained } from '@utils/points-notifier';
  import { EasterEggOperator, EggsKeys } from '@utils/easter-egg-operator';

  const heartBase64 =
    'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA8AAAANCAYAAAB2HjRBAAAACXBIWXMAABYlAAAWJQFJUiTwAAAAY0lEQVQokZWRQQ4AIQgDW///Z/awMVgE1F7UlKkECJdBxZM3C6wg2XlqzhvpJHIRwPDGFMx6jRryIouyE/wIAs3ALiD57ipg2QJir20A5djhMiCCFbwFZOBJZv+qX2apAZ35AcnfHQzDTZcFAAAAAElFTkSuQmCC';

  const KONAMI_CODE = [
    'arrowup',
    'arrowup',
    'arrowdown',
    'arrowdown',
    'arrowleft',
    'arrowright',
    'arrowleft',
    'arrowright',
    'keyb',
    'keya',
  ];

  const createCombinationRevealer = (combination, onMatchFn) => ({
    items: [],
    appendItem: function (key) {
      this.items.push(key);

      if (this.items.length > combination.length) {
        this.items.shift();
      }

      if (isEqual(combination, this.items)) {
        onMatchFn(combination);
      }
    },
  });

  const heartBeeper = () => {
    const heartRowEl = document.createElement('div');

    const properties = Object.fromEntries([
      ['position', 'fixed'],
      ['top', '4px'],
      ['left', '4px'],
      ['display', 'flex'],
      ['gap', '4px'],
      ['align-items', 'flex-start'],
      ['z-index', '11'],
    ]);

    // Apply styling for a div
    for (const [key, value] of Object.entries(properties)) {
      heartRowEl.style.setProperty(key, value);
    }

    // Heart image
    const heartEl = new Image();
    heartEl.src = heartBase64;
    heartEl.width = '24';
    heartEl.height = '24';

    const audio = new Audio(
      'data:audio/mpeg;base64,'
    );

    audio.volume = 0.33;

    // Add initial three hearts at once
    for (let i = 0; i < 3; i++) {
      heartRowEl.appendChild(heartEl.cloneNode(true));
    }

    audio.play();

    setTimeout(() => {
      // Add hearts each 200 ms
      const interval = setInterval(() => {
        heartRowEl.appendChild(heartEl.cloneNode(true));
        audio.play();
      }, 200);

      // Stop after 1400 ms
      setTimeout(() => {
        clearInterval(interval);
      }, 1400);

      // Initial wait
    }, 1250);

    document.body.appendChild(heartRowEl);
    EasterEggOperator.completeByKey(EggsKeys.KONAMI_CODE);

    const easterEggListOperator = EasterEggOperator.listOperator;
    const pointsGained = easterEggListOperator.getByKey(
      EggsKeys.KONAMI_CODE
    ).points;
    notifyPointsGained(pointsGained);
  };

  // Instance of a class that checks if a user pressed KONAMI_CODE,
  // then executes the heartBeeper function if so
  const keysHolder = createCombinationRevealer(KONAMI_CODE, heartBeeper);

  document.addEventListener('keydown', (event) => {
    const { code } = event;

    const normalizedKey = code.toLowerCase();

    keysHolder.appendItem(normalizedKey);
  });
</script>
