---
import { Icon } from 'astro-icon/components';
import { init, getLocale } from '@utils/i18n/get-locale.js';
import TempDarkModeSwitch from './TempDarkModeSwitch.jsx';
import BurgerMenu from './BurgerMenu.astro';
import SearchIconImpl from './Search/SearchIconImpl.astro';
import FlagLogo from './FlagLogo.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { getHeaderRoutesConfig } from '../data/header-routes.js';

const locale = getLocale(Astro.url);
const { t } = init(Astro.url);
const list = getHeaderRoutesConfig(locale, t);
---

<header >
  <div
    class="container z-10 relative flex items-center justify-between h-14 px-0 xl:h-auto"
  >
    <BurgerMenu />
    <div
        id="headerListWrapper"
        class="left_merge fixed transition-transform z-20 top-0 xl:h-[98px] -translate-y-full -translate-x-1/2 border-b-2 border-t-2 pt-0 pb-9 border-secondary-400-dark dark:border-primary-dark flex justify-center gap-11 after:absolute after:bottom-0 after:-right-1 dark:after:bg-primary-dark after:bg-secondary-400-dark after:rounded-full xl:translate-y-0 xl:left-0 xl:items-center xl:translate-x-0 xl:m-0 xl:border-t-0 xl:gap-4 xl:relative xl:py-0 xl:pl-6 xl:pr-14 xl:after:size-4 xl:after:translate-y-2"
    >
      <div class="relative hidden xl:block size-14">
        <div class="dark:opacity-0 absolute">
          <a class="" href={`/${locale}`}>
            <Icon name="logo-light" class="size-14" />
          </a>
        </div>

        <div class="opacity-0 dark:opacity-100 absolute">
          <a href={`/${locale}`}>
            <Icon name="logo" class="size-14" />
          </a>
        </div>
      </div>

      {/* Десктопне меню */}
      <ul class="hidden xl:flex xl:gap-4 lg:gap-6 xl:flex-row flex-col xl:h-full items-stretch">
        {
          list.map((link) => (
              <li class="group relative text-center max-w-[160px] flex items-center justify-center xl:h-full">
                <a
                    class="block xl:px-3 lg:px-5 hover:underline text-base xl:text-lg lg:text-xl relative z-20"
                    href={link.href}
                    onclick={link.linkInactive}
                >
                  {link.title}
                </a>

                {link.sublist && (
                    <div class={`dropdown-fix ${link.className || ''} hidden group-hover:block transition-opacity duration-300 left-1/2 -translate-x-1/2 xl:min-w-64 lg:min-w-80 xl:absolute xl:top-full xl:block xl:opacity-0 xl:pointer-events-none xl:group-hover:opacity-100 xl:group-hover:pointer-events-auto z-20`}>
                      <ul class="flex flex-col xl:gap-3 lg:gap-6 py-2 lg:text-background-dark text-background-dark dark:text-primary-dark lg:dark:text-primary-dark dark:bg-background-dark bg-background-light border-x-2 border-b-2 xl:border-t-0 border-secondary-400-dark dark:border-primary-dark xl:pt-2 lg:pt-4 xl:pb-4 lg:pb-7 xl:text-base xl:pl-3 xl:pr-3 lg:pl-4 lg:pr-4 lg:text-lg xl:rounded-b-2xl xl:rounded-t-none lg:rounded-b-3xl lg:rounded-t-none lg:w-auto lg:m-0 relative z-30">

                        {link.sublist.map((sublink) => (
                            <li>
                              <a class="hover:underline leading-5 relative z-30" href={sublink.href}>
                                {sublink.title}
                              </a>
                            </li>
                        ))}
                      </ul>
                    </div>
                )}
              </li>
          ))
        }
      </ul>

      <ul class="flex xl:hidden gap-4 xl:gap-6 xl:flex-row flex-col">
        <li class="text-center lg:px-5 leading-none">
          <a
            class="block hover:underline sm:text-base text-base lg:text-xl select-none"
            href={'/'}>{t('titles.mainPage')}</a
          >
        </li>
        {
          list.map((link) => (
            <li class="group relative text-center lg:px-5 leading-none">
              <a
                class="block hover:underline sm:text-base text-base lg:text-xl select-none"
                href={link.href}
              >
                {link.title}
              </a>
              {link.sublist && (
                <div class="relative hidden group-hover:block transition-opacity duration-300 left-1/2 -translate-x-1/2 lg:translate-y-[1.5px] max-w-80 lg:min-w-48 lg:pt-8 lg:absolute lg:block lg:opacity-0 lg:pointer-events-none lg:group-hover:opacity-100 lg:group-hover:pointer-events-auto">
                  <ul class="relative flex flex-col gap-3 py-2 mt-4  text-background-dark dark:text-white dark:bg-background-dark bg-background-light border-y-2 border-secondary-400-dark dark:border-primary-dark  lg:pt-4 lg:pb-7 lg:gap-6 lg:text-background-dark lg:dark:text-primary-dark lg:w-auto lg:m-0 lg:border-2 lg:border-t-0 lg:rounded-3xl lg:rounded-tl-none lg:rounded-tr-none">
                    <span class="absolute -top-[1px] -left-1 size-2 -translate-y-1/2 rounded-full bg-secondary-300-dark dark:bg-primary-dark lg:hidden" />
                    <span class="absolute -top-[1px] -right-1 size-2 -translate-y-1/2 rounded-full bg-secondary-300-dark dark:bg-primary-dark lg:hidden" />
                    <span class="absolute -bottom-[1px] -left-1 size-2 translate-y-1/2 rounded-full bg-secondary-300-dark dark:bg-primary-dark lg:hidden" />
                    <span class="absolute -bottom-[1px] -right-1 size-2 translate-y-1/2 rounded-full bg-secondary-300-dark dark:bg-primary-dark lg:hidden" />

                    {link.sublist.map((sublink) => (
                      <li>
                        <a
                          class="hover:underline lg:text-lg leading-5 select-none"
                          href={sublink.href}
                        >
                          {sublink.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>

<!-- Флаг для малих екранів до 1279px -->
<div class="xl:hidden mt-[25px]">
  <FlagLogo />
</div>

<!-- Флаг для великих екранів від 1280px -->
<div class="hidden xl:flex items-center">
  <FlagLogo />
</div>

<div
  class="flex justify-between items-center dark:border-primary-dark border-secondary-400-dark border-[3px] rounded-full xl:mt-1"
>
  <TempDarkModeSwitch client:only="preact" />
  <LanguageSwitch />
  <SearchIconImpl />
</div>

</header>

<script>
  const burgerMenu = document.getElementById('burgerMenu');
  const headerList = document.getElementById('headerListWrapper');

  if (burgerMenu && headerList) {
    burgerMenu.addEventListener('click', function (e) {
      burgerMenu.classList.toggle('active');
      headerList.classList.toggle('opened');
      document.body.classList.toggle('locked');
    });
  }
</script>

<style>

/* Базове значення — тільки для мобільних і планшетів */
@media (max-width: 1279px) {
  .left_merge {
    left: 0;
    width: 100vw;
  }

  .left_merge.opened {
    transform: translateY(0) !important;
  }
}

/* Fix для dropdown: прибрала верхню лінію і скруглення 1280+ та 1440+, 
плюс зробила падінг згори, щоб бокові лінії не заходили на хедер */
@media (min-width: 1280px) and (max-width: 1439px) {
  .dropdown-fix {
    //padding-top: 50px !important;
  }

  .dropdown-fix ul {
    border-top-left-radius: 0 !important;
    border-top-right-radius: 0 !important;
  }

  .small-dropdown {
    min-width: 144px !important; 
  }

  .small-dropdown ul {
    padding-top: 8px !important;
    padding-bottom: 8px !important;
    gap: 8px !important;
  }
}

  @media (min-width: 1440px) {
    .dropdown-fix {
      //padding-top: 65px !important;
    }

    .dropdown-fix ul {
      border-top-left-radius: 0 !important;
      border-top-right-radius: 0 !important;
    }

    .small-dropdown {
    min-width: 280px;
    }

    .small-dropdown ul {
    padding-top: 10px !important;
    padding-bottom: 10px !important;
    gap: 8px !important;
    }

      .student-dropdown {
    min-width: 200px;      
  }
    .applicant-dropdown {
    min-width: 240px;
    //left: 60px;
  }
  }
</style>
