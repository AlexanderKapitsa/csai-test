<style>
#footer { 
  overflow: visible;
  height: 100%;
  max-width: 100%;
}

#footer ellipse,
rect,
polygon,
path {
  stroke: none;
	@apply fill-secondary-400-dark dark:fill-primary-dark;
}

#footer #point1,
#point2,
#point3,
#point4 {
  stroke-width: 2;
  stroke: none;
	@apply fill-secondary-400-dark dark:fill-primary-dark;
}

#footer #line, #line1,
#line2,
#line3,
#line4 {
  stroke-width: 2;
	@apply stroke-secondary-400-dark dark:stroke-primary-dark;
  fill: none
}
</style>

<script>
  import { gsap } from 'gsap';

  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  // Анимация появления
// gsap.from("#footer", {
//   opacity: 0,
//   y: -50, // Переместить заголовок вверх
//   duration: 1.5,
//   ease: "power2.out",
//   delay: 0.5 // Задержка перед анимацией
// });

//register the plugin (just once)
gsap.registerPlugin(MotionPathPlugin);

//------- размеры точек

//gsap.set("#point1", { scale: 0.5, autoAlpha: 1 });
//gsap.set("#point2", { scale: 0.5, autoAlpha: 1 });
//gsap.set("#point3", { scale: 0.5, autoAlpha: 1 });
//gsap.set("#point4", { scale: 0.5, autoAlpha: 1 });

//------- движение точек и подсветка линий

// получаем весь список отрезков.
const lines = document.querySelectorAll('#line');

const durationFactor = 2;

function moveDot(point, index) {
	const line = lines[index];
	
	let randDurration = (0.7 + Math.random()) * durationFactor;
	
	gsap.set(point, { scale: 0.5, autoAlpha: 0 });
		
	gsap.to(point, {
	  duration: randDurration,
	  ease: "linear",
	  immediateRender: true,
	  motionPath: {
		path: line,
		align: line,
		alignOrigin: [0.5, 0.5]
	  },
	  onStart: function(){
		  gsap.to(point, {autoAlpha: 1, duration: 0.33})
	  },
	  //repeat: 0,
	  //yoyo: true,
	  onComplete: function(){
		//console.log("end");
		gsap.to(point, {autoAlpha: 0, duration: 0.33, onComplete: function(){
			index++;
			if(index >= lines.length)
			{
				index = 0;
			}
			moveDot(point, index);
		}});
	  }
	});

	gsap.to(line, {
		duration: randDurration/2 ,
		repeat: 1,
		ease: "power2.out",
		yoyo: true,
		onUpdate: function() {
			let progress = this.progress();
			
			// Обновить цвет 1F4BDF
			//const currentColor = gsap.utils.interpolate("#52CCF2", "#00FFFF", progress);
			//line.style.stroke = currentColor;
			//point.style.color = currentColor;

			// Обновить толщину
			const currentWidth = gsap.utils.interpolate(2, 10, progress);
			line.style.strokeWidth = currentWidth + "px";

			// Показать линию
			line.style.opacity = 1;
		  }
	});
}

moveDot("#point1", Math.floor(Math.random() * lines.length));
moveDot("#point2", Math.floor(Math.random() * lines.length));
moveDot("#point3", Math.floor(Math.random() * lines.length));
moveDot("#point4", Math.floor(Math.random() * lines.length));

//------- мигание кругов и квадратов 

// Выберите все элементы (эллипсы и прямоугольники)
const elements = document.getElementById('ends').children;

// Функция для пульсации одного элемента
function pulsateElement(element) {
  // Анимация пульсации
  gsap.to(element, {
    scale: 1.2, // Увеличить масштаб на 10%
    transformOrigin: "50% 50%",
    duration: 0.5 * durationFactor, // 0.5 секунды для увеличения
    ease: 'power2.inOut', // Плавная анимация
    yoyo: true, // Повторить анимацию в обратном направлении (уменьшение)
	repeat: 1
  });
}

// Функция для запуска пульсации следующего элемента
function startNextPulsation() {
  // Если нет активного элемента
  
    // Выбрать случайный элемент
    const randomIndex = Math.floor(Math.random() * elements.length);
    
    // Запустить пульсацию для выбранного элемента
    pulsateElement(elements[randomIndex]);
  

  // Запланировать следующий вызов startNextPulsation
  setTimeout(startNextPulsation, 200);
}

// Запустить начальную пульсацию
startNextPulsation();

</script>