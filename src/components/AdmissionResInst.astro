---
import AdmissionResInstPicture from './AdmissionResInstPicture.astro';
import { init } from '@utils/i18n/get-locale.js';

const { t } = init(Astro.url);
const { title, description, pictureSrc } = Astro.props;
---

<div class="flex flex-col gap-2 xl:gap-6 lg:gap-8 lg:mt-10 mt-8">
  <h3 class="lap:order-2 text-2xl md:text-3xl lap:text-4xl xl:text-5xl my-2 lg:mt-8">
    {t('admissions.resInstTitle')}
  </h3>
  <h2 class="lap:order-1 text-1xl md:text-2xl lap:text-5xl xl:text-6xl" data-pagefind-meta="title">
    {title}
  </h2>
</div>
<div class="relative flex gap-2 justify-between py-4 lg:h-80">
  <div class="flex flex-col gap-2 max-w-44">
    <p
      class="w-[170px] md:w-[300px] lap:w-[500px] xl:w-[550px] lg:w-[600px] lg:leading-10 md:text-xl lap:text-2xl xl:text-3xl xl:line-clamp-6 dark:text-background-light"
    >
      {description}
    </p>
  </div>
  <div class="relative md:top-10 md:-left-10 lap:top-12 lap:-left-14 xl:-left-16 xl:top-14 lg:-top-40 lg:-left-16">
    <AdmissionResInstPicture pictureSrc={pictureSrc} />
  </div>
</div>
