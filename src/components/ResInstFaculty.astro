---
import ResInstPhotoFaculty from './ResInstPhotoFaculty.astro';
import { getLocale } from '@utils/i18n/get-locale.js';

const allFaculties = await Astro.glob('../pages/faculty/*/index.mdx');

const locale = getLocale(Astro.url);
let faculty = allFaculties.filter((f) => f.file.includes(`/${locale}/`));
const { title, description, pictures } = faculty[0].frontmatter.resInst;

const picturesSrc = pictures.map((item) => item.picture);
---

<section
  class="min-h-[190px] xl:min-h-[400px] xl:mt-14 lg:mb-40 mt-8 mb-6 flex"
>
  <article class="lap:w-1/2 w-7/12" data-pagefind-body>
    <h1 class="text-xl md:text-3xl lap:text-4xl xl:text-5xl lg:text-7xl" data-pagefind-meta="title">{title}</h1>
    <p class=" text-xs md:text-base lap:text-xl xl:text-xl lg:text-2xl xl:mt-8 mt-4">{description}</p>
  </article>
  <ResInstPhotoFaculty picturesSrc={picturesSrc} />
</section>
