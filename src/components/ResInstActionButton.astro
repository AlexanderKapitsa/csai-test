---
import { Icon } from 'astro-icon/components';

const { title } = Astro.props;
---

<button
  class="md:hover:scale-105 md:transition-transform md:duration-150 inline-flex rounded-full items-center gap-1 md:gap-5 h-12 w-[190px] md:h-[60px] md:w-[332px] bg-secondary-400-dark dark:bg-primary-dark cursor-pointer select-none"
>
  <Icon
    class="w-12 md:w-[60px] h-12 md:h-[60px] bg-background-light dark:bg-background-dark text-secondary-400-dark dark:text-primary-dark border border-secondary-400-dark dark:border-primary-dark rounded-full"
    name="res-inst/res-inst-action-down-arrow"
  />
  <span
    class="mr-4 md:mr-10 text-background-light text-md md:text-xl dark:text-background-dark"
  >
    {title}
  </span>
</button>
