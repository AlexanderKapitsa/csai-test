---
import Banner from './Banner.astro';

const mode = import.meta.env.ASTRO_ENV;

let text;
let colorHex;

switch (mode) {
  case "TEST":
    text = "TEST";
    colorHex = "#ff0000";
    break;
}

const isPreviewVersion = mode === "TEST";
---

{isPreviewVersion && <Banner text={text}
        colorHex={colorHex}/>}
