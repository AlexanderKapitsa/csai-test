---
const { href, label, className } = Astro.props;
---

<a
  href={href}
  class=`lg:mt-5 md:text-lg lap:text-xl xl:text-2xl lg:text-3xl xl:py-3 lg:py-4 xl:px-8 lg:px-9 w-full md:w-[350px] lap:w-[400px] xl:w-[450px] lg:w-[550px] mt-4 py-2 px-6 inline-block rounded-full bg-secondary-400-dark dark:bg-primary-dark text-background-light select-none ${className?className:''}`
  target="_blank">{label}</a
>
