---
import { init } from '@utils/i18n/get-locale.js';

const { t, l } = init(Astro.url);
---

<section class="flex min-h-[60svh] items-center justify-center px-4 py-12 text-center whitespace-normal">
  <div class="max-w-lg">
    <h1 class="text-2xl md:text-3xl font-bold">
      {t('pageNotFound.title')}
    </h1>
    <p class="mt-4 text-base md:text-lg">
      {t('pageNotFound.description')}
    </p>
    <a
      href={l('/')}
      class="mt-6 inline-block text-accent-700-light dark:text-secondary-300-dark underline underline-offset-4 hover:no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      {t('pageNotFound.backHome')}
    </a>
  </div>
</section>