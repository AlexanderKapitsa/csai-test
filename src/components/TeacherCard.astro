---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  headingText: string;
  pictureSrc: string;
}

const { headingText, pictureSrc } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif}');
if (!images[pictureSrc]) throw new Error(`"${pictureSrc}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif}"`);
---

<div class="flex gap-4 mb-8">
  <Picture src={images[pictureSrc]()} alt=""
           style="aspect-ratio: 1"
           formats={['avif', 'webp']}
           width="200" height="200"
           densities={[1, 1.5, 2, 3]}
           class="rounded-full object-cover object-center" />
  <div class="flex flex-col gap-2">
    <h2>Name: <b>{headingText}</b></h2>
    <h3>Lorem ipsum dolor.</h3>
    <p>Email: <a class="text-blue-500" href="mailto:zinoviev@example.com">zinoviev@example.com</a></p>
  </div>
</div>
