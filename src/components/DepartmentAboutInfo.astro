---
import Subtitle from './Subtitle.astro';
import { init } from '@utils/i18n/get-locale.js';
import { marked } from 'marked';

interface Props {
  longAbout?: string;
}

const { longAbout } = Astro.props;
const { t } = init(Astro.url);
---

{
  longAbout && (
    <div class="flex flex-col gap-2 lg:gap-4 mt-2 lg:mt-8 text-xs md:text-lg lap:text-xl xl:text-2xl lg:text-3xl">
      <Subtitle text={`${t('departments.about')}`} />
      <p set:html={marked.parse(longAbout)} ></p>
    </div>
  )
}
