---
import { Icon } from 'astro-icon/components';
---

<div
  class="relative h-8 bg-secondary-400-dark dark:bg-secondary-700-dark text-white">
  <div
    class="container flex gap-3 h-full items-center px-22 sm:justify-center lg:justify-start">
    <Icon name="karazin-logo" class="size-8" />
    <p class="lg:text-base sm:text-sm">Класика, що випереджає час</p>
  </div>
  <a
    href="https://karazin.ua/"
    target="_blank"
    class="absolute w-full h-full top-0 left-0 z-10"></a>
</div>
