---
import ResInstPhotoDepartment from './ResInstPhotoDepartment.astro';
import Copyright from './Copyright.astro';
import CentralPanel from './Shared/CentralPanel.astro';
import LeftPanel from './Shared/LeftPanel.astro';
import BasicPageHeader from './Shared/BasicPageHeader.astro';
import BasicMobilePageHeader from './Shared/BasicMobilePageHeader.astro';
import BasicParagraph from './Shared/BasicParagraph.astro';
import RightPanel from './Shared/RightPanel.astro';

const { frontmatter } = Astro.props;
---

<CentralPanel className="flex justify-between">
  <LeftPanel>
    <BasicPageHeader title={frontmatter.title} />
    <BasicMobilePageHeader title={frontmatter.mtitle} />

    <div class="flex flex-col gap-2 lg:gap-4 mt-2 lap:mt-4  xl:mt-8 md:text-base lap:text-lg xl:text-xl text-xs lg:text-3xl">
      <BasicParagraph text={frontmatter.about} />
    </div>
  </LeftPanel>
  <RightPanel>
    <ResInstPhotoDepartment picture={frontmatter.picture} />
    <div class="flex lg:mt-[560px] mt-[170px] md:mt-[240px] lap:mt-[360px] xl:mt-[460px] justify-end">
      <Copyright text={frontmatter.deanName} />
    </div>
  </RightPanel>
</CentralPanel>
