---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { pictureSettings } from '../../app.config';

const {
  pictureSrc,
  throwErrorOnNoPicFound = true,

  widthMobile = 100,
  heightMobile = 100,
  widthMd = 160,
  heightMd = 190,
  widthLap = 260,
  heightLap = 320,
  widthXl = 320,
  heightXl = 420,
  widthDesktop = 387,
  heightDesktop = 512,
} = Astro.props;


let actualSrc = '';

if (pictureSrc) {
  actualSrc = pictureSrc.replaceAll('../../', '../');
}

const images = import.meta.glob<{
  default: ImageMetadata;
}>('../assets/*.{jpeg,jpg,png,webp,avif,gif,svg,JPEG,JPG,PNG,WEBP,AVIF,GIF,SVG}', {eager: false});

const classes = `
  object-cover object-center rounded-md
  w-[${widthMobile}px] h-[${heightMobile}px]
  md:w-[${widthMd}px] md:h-[${heightMd}px] 
  lap:w-[${widthLap}px] lap:h-[${heightLap}px] 
  xl:w-[${widthXl}px] xl:h-[${heightXl}px] 
  lg:w-[${widthDesktop}px] lg:h-[${heightDesktop}px]
`;

const aspectRatios = {
  mobile: widthMobile / heightMobile,
  md: widthMd / heightMd,
  lap: widthLap / heightLap,
  xl: widthXl / heightXl,
  desktop: widthDesktop / heightDesktop,
};

const style = `
  aspect-ratio: ${aspectRatios.mobile};
  @media (min-width: 768px) { aspect-ratio: ${aspectRatios.md}; }
  @media (min-width: 1024px) { aspect-ratio: ${aspectRatios.lap}; }
  @media (min-width: 1280px) { aspect-ratio: ${aspectRatios.xl}; }
  @media (min-width: 1440px) { aspect-ratio: ${aspectRatios.desktop}; }
`;

const image = images[actualSrc]?.()
---

{image ? (
  <>
      <Picture
        src={image}
        alt="Picture"
        formats={pictureSettings.formats}
        quality="high"
        densities={pictureSettings.densities}
        class={classes}
        style={style}
      />
  </>
) : (
  <!-- fallback -->
  <div
    class={`relative flex items-center justify-center w-[${widthMobile}px] h-[${heightMobile}px] md:w-[${widthMd}px] md:h-[${heightMd}px] lap:w-[${widthLap}px] lap:h-[${heightLap}px] xl:w-[${widthXl}px] xl:h-[${heightXl}px] lg:w-[${widthDesktop}px] lg:h-[${heightDesktop}px] bg-background-light dark:bg-background-dark rounded-md`}>
    <Icon
      name="placeholder-logo"
      class="absolute top-[50%] left-[50%] text-background-dark dark:text-background-light -translate-x-1/2 -translate-y-1/2 w-20 h-20 lap:w-36 xl:h-36 opacity-1"
    />
  </div>
)}
