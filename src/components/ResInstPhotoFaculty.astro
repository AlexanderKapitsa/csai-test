---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
let { picturesSrc } = Astro.props;
import { pictureSettings } from '../../app.config';

const images = import.meta.glob<{
  default: ImageMetadata
}>('../assets/*.{jpeg,jpg,png,webp,avif,gif,svg,JPEG,JPG,PNG,WEBP,AVIF,GIF,SVG}');

picturesSrc = picturesSrc.map((src) => src.replaceAll('../../', '../'));

const imageStyles = [
  // Фото 1
  'object-center object-cover z-[3] absolute left-[202px] top-[66px] md:left-[550px] md:top-[80px] lap:left-[730px]  xl:left-[800px] xl:top-[120px] lg:left-[821px] lg:top-[123px] w-[70px] h-[70px] md:w-[110px] md:h-[110px] lap:w-[170px] lap:h-[170px] xl:w-[250px] xl:h-[250px]   lg:w-[320px] lg:h-[320px] rounded-full border-2 lg:border-[5px] dark:border-primary-dark border-secondary-300-dark lg:border-secondary-300-dark lg:dark:border-primary-dark',

  // Фото 2
  'object-center object-cover z-[3] absolute left-[247px] top-[116px] md:left-[600px] md:top-[180px] lap:left-[820px] lap:top-[230px] xl:left-[1050px] xl:top-[250px] lg:left-[1150px] lg:top-[316px] w-[103px] h-[103px] md:w-[130px] md:h-[130px] lap:w-[200px] lap:h-[200px] xl:w-[150px] xl:h-[150px] lg:w-[220px] lg:h-[220px] rounded-full border-2 lg:border-[5px] dark:border-primary-dark border-secondary-400-dark lg:dark:border-primary-dark lg:border-secondary-700-light',

  // Фото 3
  'object-center object-cover z-[3] absolute left-[237px] top-[222px] md:left-[550px] md:top-[300px] lap:left-[740px] lap:top-[400px] xl:left-[900px] xl:top-[370px] lg:left-[907px] lg:top-[447px] w-[53px] h-[53px] md:w-[90px] md:h-[90px] lap:w-[150px] lap:h-[150px] xl:w-[223px] xl:h-[223px] lg:w-[293px] lg:h-[293px] rounded-full border-2 lg:border-[5px] dark:border-primary-dark border-secondary-700-light lg:border-secondary-400-dark lg:dark:border-primary-dark'
];


---

<div class="xl:w-1/2">
  {picturesSrc.map((src, index) =>
    <Picture src={images[src]()} alt=""
            formats={pictureSettings.formats}
            quality="high"
            width={293 * 1.5} height={293 * 1.5}
            densities={pictureSettings.densities}
            class={imageStyles[index]}
    />)}

<!-- 1blueTopLeft -->
<div class="absolute xl:bg-secondary-700-light xl:dark:border-4 lg:dark:border-8 dark:border-2 dark:bg-transparent dark:border-primary-dark bg-secondary-400-dark rounded-full z-1 lap:w-[22px] lap:h-[22px] xl:w-[72px] xl:h-[72px] xl:left-[702px] xl:top-[130px] lg:w-[92px] lg:h-[92px] lg:left-[706px] lg:top-[138px] md:left-[550px] md:top-[65px] lap:left-[710px] lap:top-[90px] xl:left-[720px] left-[180px] top-[58px] w-[13px] h-[13px]"></div>

<!-- 2blueTopRight -->
<div class="absolute xl:bg-secondary-700-dark xl:dark:border-4 lg:dark:border-8 dark:border-2 dark:bg-transparent bg-secondary-300-dark border-secondary-300-dark lg:border-secondary-700-dark dark:border-primary-dark rounded-full z-1 lap:w-[42px] lap:h-[42px] xl:w-[72px] xl:h-[72px] xl:left-[1080px] xl:top-[170px] lg:w-[92px] lg:h-[92px] lg:left-[1214px] lg:top-[196px] md:left-[680px] md:top-[130px] lap:left-[930px] lap:top-[170px] left-[290px] top-[74px] w-[31px] h-[31px]"></div>

<!-- 3sky-blueTop -->
<div class="absolute dark:bg-primary-dark xl:bg-secondary-400-dark bg-secondary-700-light rounded-full z-[2] lap:w-[22px] lap:h-[22px] xl:w-[57px] xl:h-[57px] xl:left-[799px] xl:top-[370px] lg:w-[77px] lg:h-[77px] lg:left-[799px] md:left-[570px] md:top-[230px] lap:left-[770px] lap:top-[300px] lg:top-[426px] left-[226px] top-[168px] w-[13px] h-[13px]"></div>

<!-- 4sky-blueBottom -->
<div class="absolute xl:bg-secondary-700-dark bg-secondary-300-dark dark:bg-transparent rounded-full z-1 lap:w-[32px] lap:h-[32px] w-[21px] h-[21px] xl:w-[40px] xl:h-[40px] xl:left-[1140px] xl:top-[420px] lg:w-[60px] lg:h-[60px] lg:left-[1246px] lg:top-[574px] md:left-[680px] md:top-[320px] lap:left-[940px] lap:top-[440px] left-[310px] top-[230px] border-[2px] xl:border-[4px] lg:border-[8px] border-secondary-300-dark xl:border-secondary-700-dark dark:border-primary-dark xl:dark:border-primary-dark lg:dark:border-primary-dark"></div>

<!-- 5sky-blueLeftBottom -->
<div class="absolute bg-secondary-400-dark dark:bg-primary-dark rounded-full z-1 xl:w-[98px] xl:h-[98px] lg:w-[108px] lg:h-[108px] xl:left-[-66px] md:left-[300px] xl:top-[550px] lg:top-[608px] left-[217px] top-[185px] w-[38px] h-[38px] xl:block hidden"></div>

<!-- 6blueLeftBottom -->
<div class="absolute xl:bg-secondary-700-light bg-secondary-300-dark xl:dark:border-8 dark:bg-transparent dark:border-primary-dark  rounded-full z-[2] xl:w-[88px] xl:h-[88px] xl:left-[-90px] lg:left-[-80px] md:left-[340px] xl:top-[500px] lg:top-[554px] left-[286px] top-[93px] w-[50px] h-[50px] xl:block hidden"></div>

</div>

<style>
  .border{
    border-width: 8px;
    @media (max-width: 1279px) {
      border-width: 3px;
    }
  }
</style>