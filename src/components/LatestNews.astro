---
import NewsItemSmall from './NewsItemSmall.astro';
import { init, getLocale } from '@utils/i18n/get-locale.js';

const locale = getLocale(Astro.url);
const { t } = init(Astro.url);
const AMOUNT_OF_LATEST_NEWS = 3;

const { ignoreNewsUrl } = Astro.props;

const latestNews = await importLatestNewsOfAmount(AMOUNT_OF_LATEST_NEWS);

async function importLatestNewsOfAmount(amount) {
  let news = await importNews();
  news = removeNewsByUrl(news, ignoreNewsUrl);
  news = sortByCreatedAtByDesc(news);
  news = getFirstOfAmount(news, amount);

  return news;
}

async function importNews() {
  let newsPages = await Astro.glob(`../pages/news/*/*.mdx`);
  newsPages = newsPages.filter((f) => f.file.includes(`/${locale}/`));
  return newsPages;
}

function removeNewsByUrl(news, url) {
  return news.filter(({ url: originalUrl }) => originalUrl !== url);
}

function sortByCreatedAtByDesc(news) {
  return [...news].sort(
    (a, b) =>
      new Date(b.frontmatter.createdAt).getTime() -
      new Date(a.frontmatter.createdAt).getTime()
  );
}

function getFirstOfAmount(news, amount) {
  return news.slice(0, amount);
}
---

{
  latestNews.length > 1 && (
    <div>
      <h3 class="text-lg md:text-xl lap:text-2xl xl:text-3xl lg:text-4xl">{t('news.latestNews')}</h3>
      <ul>
        {latestNews.map(({ frontmatter: { title }, url }) => (
          <li>
            <NewsItemSmall title={title} href={url} />
          </li>
        ))}
      </ul>
    </div>
  )
}
